<Window x:Class="Alls.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Alls.Bootstrapper.Controls"
        Title="ALLS"
        Width="1280"
        Height="720"
        Background="{StaticResource BootBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <Window.Resources>
        <Style x:Key="MenuListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="#FFF1F1F1" />
            <Setter Property="Foreground" Value="#FF151515" />
            <Setter Property="BorderBrush" Value="#FFD6D6D6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFE60022" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF9D0018" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MenuEntryTemplate">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="TextElement.Foreground" Value="#FF151515" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="TextElement.Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="17" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="WindowSurface" Background="{StaticResource BootBackgroundBrush}">
    <Viewbox x:Name="DesignViewport" Stretch="Uniform">
        <Grid Width="1280" Height="720" Background="{StaticResource BootBackgroundBrush}">
            <Grid x:Name="BootScreen"
                  Visibility="{Binding IsBootVisible, Converter={StaticResource BoolToVisibility}}">
                <Image x:Name="BootLogo"
                       Width="430"
                       Height="300"
                       Margin="0,68,0,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Source="{Binding LogoPath}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False" />

                <StackPanel x:Name="BootStatusStack"
                            Width="840"
                            Margin="0,374,0,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="BootPlatformText"
                               Text="{Binding PlatformName}"
                               Style="{StaticResource PlatformNameTextStyle}" />
                    <TextBlock x:Name="BootStepText"
                               Text="{Binding StepLabel}"
                               Style="{StaticResource StepTextStyle}" />

                    <StackPanel x:Name="StatusPanel"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <controls:AnimatedGifImage x:Name="BootLoadingIndicator"
                                                   Width="46"
                                                   Height="46"
                                                   Margin="0,0,12,0"
                                                   GifSource="{Binding LoadingPath}"
                                                   IsAnimating="{Binding IsBusy}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                            <controls:AnimatedGifImage.Style>
                                <Style TargetType="controls:AnimatedGifImage">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AnimatedGifImage.Style>
                        </controls:AnimatedGifImage>
                        <TextBlock x:Name="BootMessageText"
                                   Text="{Binding Message}"
                                   Style="{StaticResource MessageTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVisibility}}">
                <Image Width="230"
                       Height="120"
                       Margin="0,4,0,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Source="{Binding LogoPath}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <Grid Width="900" Margin="0,116,0,18" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="245" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="190" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding MenuTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextAlignment="Center" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding GameListTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FF555555" />

                    <ListBox x:Name="GameMenu"
                             Grid.Row="2"
                             ItemsSource="{Binding GameEntries}"
                             SelectedIndex="{Binding SelectedGameIndex, Mode=OneWay}"
                             IsHitTestVisible="False"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource MenuListItemStyle}"
                             ItemTemplate="{StaticResource MenuEntryTemplate}" />

                    <Border Grid.Row="3" Height="2" Background="#FFD0D0D0" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4"
                               Text="{Binding OperationListTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FF555555" />

                    <ListBox x:Name="OperationMenu"
                             Grid.Row="5"
                             ItemsSource="{Binding OperationEntries}"
                             SelectedIndex="{Binding SelectedOperationIndex, Mode=OneWay}"
                             IsHitTestVisible="False"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource MenuListItemStyle}"
                             ItemTemplate="{StaticResource MenuEntryTemplate}" />

                    <TextBlock Grid.Row="6"
                               Margin="0,8,0,0"
                               Text="{Binding MenuHelp}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="18"
                               Foreground="#FF555555"
                               TextAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Width="850" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="44"
                               FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,22,0,0"
                               Text="{Binding ConfirmationMessage}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="26"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ListBox Width="520"
                             Height="154"
                             Margin="0,44,0,0"
                             ItemsSource="{Binding ConfirmationChoices}"
                             SelectedIndex="{Binding ConfirmationSelectedIndex, Mode=OneWay}"
                             IsHitTestVisible="False"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MenuListItemStyle}">
                                <Setter Property="Margin" Value="0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="25" FontWeight="SemiBold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Width="900" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,22,0,0"
                               Text="{Binding ErrorMessage}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="27"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,48,0,0"
                               Text="{DynamicResource ERROR_MENU_HELP}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="20"
                               Foreground="#FF555555"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>

        <Canvas x:Name="MaimaiButtonGuide" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10">
            <Grid x:Name="MaimaiGuideButton1" RenderTransformOrigin="0.5,0.5">
                <Path Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="2.5"
                      Data="M 18,2 C 65,-2 135,-2 182,2 Q 196,4 191,18 L 177,49 Q 175,55 167,57 C 122,66 78,66 33,57 Q 25,55 23,49 L 9,18 Q 4,4 18,2 Z">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF4260" Offset="0" /><GradientStop Color="#FFE60025" Offset="0.45" /><GradientStop Color="#FFA9001B" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.Effect><DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" /></Path.Effect>
                </Path>
                <TextBlock Text="{DynamicResource MAIMAI_GUIDE_BUTTON_1}" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="MaimaiGuideButton2" RenderTransformOrigin="0.5,0.5">
                <Path Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="2.5"
                      Data="M 18,2 C 65,-2 135,-2 182,2 Q 196,4 191,18 L 177,49 Q 175,55 167,57 C 122,66 78,66 33,57 Q 25,55 23,49 L 9,18 Q 4,4 18,2 Z">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF4E9BE3" Offset="0" /><GradientStop Color="#FF216CB6" Offset="0.5" /><GradientStop Color="#FF104B88" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.Effect><DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" /></Path.Effect>
                </Path>
                <TextBlock Text="{DynamicResource MAIMAI_GUIDE_BUTTON_2}" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="MaimaiGuideButton4" RenderTransformOrigin="0.5,0.5">
                <Path Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="2.5"
                      Data="M 18,2 C 65,-2 135,-2 182,2 Q 196,4 191,18 L 177,49 Q 175,55 167,57 C 122,66 78,66 33,57 Q 25,55 23,49 L 9,18 Q 4,4 18,2 Z">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF4260" Offset="0" /><GradientStop Color="#FFE60025" Offset="0.45" /><GradientStop Color="#FFA9001B" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.Effect><DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" /></Path.Effect>
                </Path>
                <TextBlock Text="{DynamicResource MAIMAI_GUIDE_BUTTON_4}" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="MaimaiGuideButton5" RenderTransformOrigin="0.5,0.5">
                <Path Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="2.5"
                      Data="M 18,2 C 65,-2 135,-2 182,2 Q 196,4 191,18 L 177,49 Q 175,55 167,57 C 122,66 78,66 33,57 Q 25,55 23,49 L 9,18 Q 4,4 18,2 Z">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF4260" Offset="0" /><GradientStop Color="#FFE60025" Offset="0.45" /><GradientStop Color="#FFA9001B" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.Effect><DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" /></Path.Effect>
                </Path>
                <TextBlock Text="{DynamicResource MAIMAI_GUIDE_BUTTON_5}" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="MaimaiGuideButton7" RenderTransformOrigin="0.5,0.5">
                <Path Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="2.5"
                      Data="M 18,2 C 65,-2 135,-2 182,2 Q 196,4 191,18 L 177,49 Q 175,55 167,57 C 122,66 78,66 33,57 Q 25,55 23,49 L 9,18 Q 4,4 18,2 Z">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF4E9BE3" Offset="0" /><GradientStop Color="#FF216CB6" Offset="0.5" /><GradientStop Color="#FF104B88" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.Effect><DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" /></Path.Effect>
                </Path>
                <TextBlock Text="{DynamicResource MAIMAI_GUIDE_BUTTON_7}" Foreground="White" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
