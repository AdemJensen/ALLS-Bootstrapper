<Window x:Class="Alls.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Alls.Bootstrapper.Controls"
        Title="ALLS"
        Width="1280"
        Height="720"
        Background="{StaticResource BootBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown">
    <Grid x:Name="WindowSurface" Background="{StaticResource BootBackgroundBrush}">
    <Viewbox x:Name="DesignViewport" Stretch="Uniform">
        <Grid Width="1280" Height="720" Background="{StaticResource BootBackgroundBrush}">
            <Grid Visibility="{Binding IsBootVisible, Converter={StaticResource BoolToVisibility}}">
                <Image Width="430"
                       Height="300"
                       Margin="0,68,0,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Source="{Binding LogoPath}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False" />

                <StackPanel Width="840"
                            Margin="0,374,0,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PlatformName}"
                               Style="{StaticResource PlatformNameTextStyle}" />
                    <TextBlock Text="{Binding StepLabel}"
                               Style="{StaticResource StepTextStyle}" />

                    <StackPanel x:Name="StatusPanel"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <controls:AnimatedGifImage Width="46"
                                                   Height="46"
                                                   Margin="0,0,12,0"
                                                   GifSource="{Binding LoadingPath}"
                                                   IsAnimating="{Binding IsBusy}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                            <controls:AnimatedGifImage.Style>
                                <Style TargetType="controls:AnimatedGifImage">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AnimatedGifImage.Style>
                        </controls:AnimatedGifImage>
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource MessageTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVisibility}}">
                <Image Width="300"
                       Height="185"
                       Margin="0,18,0,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Source="{Binding LogoPath}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Width="900" Margin="0,190,0,28" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding MenuTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextAlignment="Center" />

                    <ListBox x:Name="GameMenu"
                             Height="390"
                             Margin="0,16,0,0"
                             ItemsSource="{Binding MenuEntries}"
                             SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                             IsHitTestVisible="False"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="22,13" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="Background" Value="#FFF1F1F1" />
                                <Setter Property="BorderBrush" Value="#FFD6D6D6" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#FFE60022" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FF9D0018" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="TextElement.Foreground" Value="#FF151515" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="19" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding MenuHelp}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="18"
                               Foreground="#FF555555"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Width="900" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorTitle}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,22,0,0"
                               Text="{Binding ErrorMessage}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="27"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,48,0,0"
                               Text="{DynamicResource ERROR_MENU_HELP}"
                               FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
                               FontSize="20"
                               Foreground="#FF555555"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
    </Grid>
</Window>
