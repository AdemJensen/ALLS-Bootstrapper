<Window x:Class="Alls.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Alls.Bootstrapper.Controls"
        Title="ALLS"
        Width="1280"
        Height="720"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown">
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="720" Background="{StaticResource BootBackgroundBrush}">
            <Image Width="430"
                   Height="300"
                   Margin="0,68,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Source="{Binding LogoPath}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   IsHitTestVisible="False" />

            <StackPanel Width="840"
                        Margin="0,374,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding PlatformName}"
                           Style="{StaticResource PlatformNameTextStyle}" />

                <TextBlock Text="{Binding StepLabel}"
                           Style="{StaticResource StepTextStyle}" />

                <StackPanel x:Name="StatusPanel"
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <controls:AnimatedGifImage Width="46"
                                               Height="46"
                                               Margin="0,0,12,0"
                                               GifSource="{Binding LoadingPath}"
                                               IsAnimating="{Binding IsBusy}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                        <controls:AnimatedGifImage.Style>
                            <Style TargetType="controls:AnimatedGifImage">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AnimatedGifImage.Style>
                    </controls:AnimatedGifImage>
                    <TextBlock Text="{Binding Message}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MessageTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
