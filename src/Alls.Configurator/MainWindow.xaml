<Window x:Class="Alls.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Alls.Configurator.Infrastructure"
        mc:Ignorable="d"
        Title="ALLS Configurator"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
    <Window.Resources>
        <ui:DelimitedListConverter x:Key="DelimitedListConverter" />

        <SolidColorBrush x:Key="AccentBrush" Color="#D81532" />
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#687386" />
        <SolidColorBrush x:Key="LineBrush" Color="#D9DEE8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,20,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Padding" Value="16,12,16,16" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,12,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="#D9DEEA" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#253149" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D81532" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Width="0" Height="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172033">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="108" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="22,20,18,12">
                    <TextBlock Text="ALLS" Foreground="White" FontWeight="Bold" FontSize="30" />
                    <TextBlock Text="C O N F I G U R A T O R" Foreground="#95A1B7" FontWeight="SemiBold" FontSize="10" />
                </StackPanel>
                <ListBox x:Name="SectionList" Grid.Row="1" SelectedIndex="0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         SelectionChanged="OnSectionChanged">
                    <ListBoxItem Content="概览与显示" />
                    <ListBoxItem Content="游戏" />
                    <ListBoxItem Content="默认时间线" />
                    <ListBoxItem Content="输入设备" />
                    <ListBoxItem Content="更新源" />
                    <ListBoxItem Content="机台操作" />
                    <ListBoxItem Content="校验与 JSON" />
                </ListBox>
                <StackPanel Grid.Row="2" Margin="18,12,18,20">
                    <TextBlock Text="当前文件" Foreground="#8995AA" FontSize="11" />
                    <TextBlock x:Name="SidebarFileName" Text="未命名配置" Foreground="White" FontSize="13"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="DirtyIndicator" Text="● 有未保存修改" Foreground="#FF9AA9" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="22,14">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="新建" Click="New_Click" />
                        <Button Content="打开…" Click="Open_Click" />
                        <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
                        <Button Content="另存为…" Click="SaveAs_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="检查配置" Click="Validate_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="EditorTabs" Grid.Row="1" SelectedIndex="0" Background="#F4F6F9" BorderThickness="0"
                        ItemContainerStyle="{StaticResource EditorTabItemStyle}">
                <!-- General -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,34,28" MaxWidth="1120" HorizontalAlignment="Left">
                            <TextBlock Text="概览与显示" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="启动器的品牌、窗口、启动入口与日志设置。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20" />

                            <GroupBox Header="基本信息">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="平台名称" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding PlatformName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="界面语言" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Text="{Binding Language, UpdateSourceTrigger=LostFocus}"><ComboBoxItem Content="zh-CN"/><ComboBoxItem Content="en-US"/><ComboBoxItem Content="ja-JP"/></ComboBox>
                                    <TextBlock Grid.Row="2" Text="Logo 图片" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LogoPathBox" Grid.Row="2" Grid.Column="1" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Content="浏览…" Click="BrowseLogo_Click"/>
                                    <TextBlock Grid.Row="3" Text="加载动画" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoadingPathBox" Grid.Row="3" Grid.Column="1" Text="{Binding LoadingPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" Content="浏览…" Click="BrowseLoading_Click"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="显示">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="窗口模式" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.WindowModes}" SelectedItem="{Binding Display.Mode}"/>
                                    <TextBlock Grid.Column="2" Text="布局预设" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Column="3" ItemsSource="{x:Static ui:EnumOptions.LayoutModes}" SelectedItem="{Binding Display.LayoutMode}"/>
                                    <TextBlock Grid.Row="1" Text="窗口宽度" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Display.Width, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="窗口高度" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Display.Height, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="2" Text="STEP 淡入 (ms)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Display.StepTransitionMs, UpdateSourceTrigger=LostFocus}"/>
                                    <WrapPanel Grid.Row="3" Grid.ColumnSpan="4">
                                        <CheckBox Content="窗口置顶" IsChecked="{Binding Display.Topmost}"/><CheckBox Content="隐藏鼠标" IsChecked="{Binding Display.HideCursor}"/><CheckBox Content="允许 Esc 退出" IsChecked="{Binding Display.AllowEscapeToExit}"/>
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="启动入口">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="启动模式" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.StartupModes}" SelectedItem="{Binding Startup.Mode}"/>
                                    <TextBlock Grid.Row="1" Text="默认游戏 ID" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="DefaultGameCombo" ItemsSource="{Binding Games}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Startup.DefaultGameId}" IsEditable="True" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="启动时允许按 SELECT 进入菜单" IsChecked="{Binding Startup.AllowSelectToOpenMenu}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="日志">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <CheckBox Grid.Column="1" Content="写入日志文件" IsChecked="{Binding Logging.Enabled}"/>
                                    <TextBlock Grid.Row="1" Text="日志路径" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Logging.File, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Games -->
                <TabItem>
                    <Grid Margin="28,24,34,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16"><TextBlock Text="游戏" Style="{StaticResource SectionTitle}"/><TextBlock Text="管理菜单中的游戏，以及每个游戏的启动、监控、更新与退出行为。" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListBox x:Name="GamesList" ItemsSource="{Binding Games}" DisplayMemberPath="Title" SelectionChanged="GamesList_SelectionChanged" BorderBrush="{StaticResource LineBrush}"/>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="添加" Click="AddGame_Click"/><Button Content="复制" Click="DuplicateGame_Click"/><Button Content="删除" Click="DeleteGame_Click"/></WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="上移" Click="MoveGameUp_Click"/><Button Content="下移" Click="MoveGameDown_Click"/></WrapPanel>
                            </Grid>
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="GameEditor" Margin="20" DataContext="{Binding SelectedItem, ElementName=GamesList}">
                                        <TextBlock Text="请从左侧选择或添加游戏" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="20" x:Name="NoGameHint"/>
                                        <StackPanel x:Name="GameFields">
                                            <GroupBox Header="身份与菜单">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="唯一 ID" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="1" Text="标题" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="2" Text="说明" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="3" Text="单独语言" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空时使用全局语言"/>
                                                    <TextBlock Grid.Row="4" Text="布局预设" Style="{StaticResource FieldLabel}"/>
                                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="GameLayoutOverride" Content="单独指定" Checked="GameLayoutOverride_Changed" Unchecked="GameLayoutOverride_Changed"/><ComboBox x:Name="GameLayoutCombo" Width="200" ItemsSource="{x:Static ui:EnumOptions.LayoutModes}" SelectedItem="{Binding LayoutMode}"/></StackPanel>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="启动命令">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <CheckBox Grid.Column="1" Content="启用启动命令" IsChecked="{Binding Launch.Enabled}"/>
                                                    <TextBlock Grid.Row="1" Text="文件" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Launch.File, UpdateSourceTrigger=PropertyChanged}" ToolTip="为空时依次尝试候选文件"/>
                                                    <TextBlock Grid.Row="2" Text="候选文件" Style="{StaticResource FieldLabel}"/><StackPanel Grid.Row="2" Grid.Column="1"><TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding Launch.Candidates, Converter={StaticResource DelimitedListConverter}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="每行一个，也可以用逗号分隔" Style="{StaticResource HintText}"/></StackPanel>
                                                    <TextBlock Grid.Row="3" Text="参数" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Launch.Arguments, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="4" Text="工作目录" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Launch.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <CheckBox Grid.Row="5" Grid.Column="1" Content="等待启动命令退出" IsChecked="{Binding Launch.WaitForExit}"/>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="进程与窗口监控">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="进程名" Style="{StaticResource FieldLabel}"/><StackPanel Grid.Column="1" Grid.ColumnSpan="3"><TextBox AcceptsReturn="True" MinHeight="58" Text="{Binding Monitor.ProcessNames, Converter={StaticResource DelimitedListConverter}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="不包含 .exe，每行一个" Style="{StaticResource HintText}"/></StackPanel>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="同时等待窗口目标" IsChecked="{Binding Monitor.Window.Enabled}"/>
                                                    <TextBlock Grid.Row="2" Text="窗口进程名" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Monitor.Window.ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="标题包含" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Monitor.Window.TitleContains, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="3" Text="窗口类名" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Monitor.Window.ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="就绪条件" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{x:Static ui:EnumOptions.TargetMatchModes}" SelectedItem="{Binding Monitor.ReadyMode}"/>
                                                    <TextBlock Grid.Row="4" Text="退出条件" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.TargetLossModes}" SelectedItem="{Binding Monitor.ExitMode}"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="启动超时 (ms)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Monitor.StartupTimeoutMs, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Grid.Row="5" Text="轮询间隔 (ms)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Monitor.PollIntervalMs, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="就绪延迟 (ms)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="5" Grid.Column="3" Text="{Binding Monitor.ReadyDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="游戏更新">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <CheckBox Grid.Column="1" Content="启动前检查更新" IsChecked="{Binding Update.Enabled}"/>
                                                    <TextBlock Grid.Row="1" Text="更新源 ID" Style="{StaticResource FieldLabel}"/><StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"><TextBox AcceptsReturn="True" MinHeight="58" Text="{Binding Update.SourceIds, Converter={StaticResource DelimitedListConverter}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="按优先级每行一个；必须与“更新源”页的 ID 一致" Style="{StaticResource HintText}"/></StackPanel>
                                                    <TextBlock Grid.Row="2" Text="应用模式" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.UpdateApplyModes}" SelectedItem="{Binding Update.ApplyMode}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="目标目录" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Update.TargetDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="3" Text="版本文件" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Update.VersionFile, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="退出行为">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <TextBlock Text="游戏结束后" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.GameExitBehaviors}" SelectedItem="{Binding OnExit}"/>
                                                    <TextBlock Grid.Row="1" Text="错误标题" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExitErrorTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="2" Text="错误消息" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExitErrorMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="该游戏专用时间线">
                                                <StackPanel>
                                                    <TextBlock Text="留空时使用“默认时间线”。这里的项目一旦存在，将完整替代默认时间线。" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                                                    <DataGrid x:Name="GameTimelineGrid" ItemsSource="{Binding Timeline}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="150" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="STEP" Binding="{Binding Step, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                                            <DataGridTextColumn Header="消息键" Binding="{Binding MessageKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                            <DataGridTextColumn Header="持续 ms" Binding="{Binding DurationMs, UpdateSourceTrigger=LostFocus}" Width="110"/>
                                                            <DataGridComboBoxColumn Header="动作" Width="120" ItemsSource="{x:Static ui:EnumOptions.BootPhaseActions}" SelectedItemBinding="{Binding Action}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <WrapPanel Margin="0,10,0,0"><Button Content="添加阶段" Click="AddGamePhase_Click"/><Button Content="删除阶段" Click="DeleteGamePhase_Click"/><Button Content="上移" Click="MoveGamePhaseUp_Click"/><Button Content="下移" Click="MoveGamePhaseDown_Click"/></WrapPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Default timeline -->
                <TabItem>
                    <StackPanel Margin="28,24,34,28">
                        <TextBlock Text="默认时间线" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="没有专用时间线的游戏会使用这里的 STEP 序列。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <DataGrid x:Name="DefaultTimelineGrid" ItemsSource="{Binding Timeline}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="360" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STEP" Binding="{Binding Step, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                        <DataGridTextColumn Header="消息键" Binding="{Binding MessageKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="持续时间 (ms)" Binding="{Binding DurationMs, UpdateSourceTrigger=LostFocus}" Width="160"/>
                                        <DataGridComboBoxColumn Header="完成动作" Width="180" ItemsSource="{x:Static ui:EnumOptions.BootPhaseActions}" SelectedItemBinding="{Binding Action}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,12,0,0"><Button Content="添加阶段" Click="AddDefaultPhase_Click"/><Button Content="删除阶段" Click="DeleteDefaultPhase_Click"/><Button Content="上移" Click="MoveDefaultPhaseUp_Click"/><Button Content="下移" Click="MoveDefaultPhaseDown_Click"/><Button Content="恢复默认" Click="ResetDefaultTimeline_Click"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Input -->
                <TabItem>
                    <Grid Margin="28,24,34,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="输入设备" Style="{StaticResource SectionTitle}"/><TextBlock Text="配置 HID 输入总开关和需要监听的机台设备。" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Border Grid.Row="1" Margin="0,16,0,16" Padding="16,8" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <WrapPanel><CheckBox Content="启用 HID 输入" IsChecked="{Binding Input.Enabled}"/><CheckBox Content="启用键盘调试" IsChecked="{Binding Input.KeyboardFallback}"/><TextBlock Text="热插拔扫描间隔 (ms)" Style="{StaticResource FieldLabel}" Margin="20,8,10,8"/><TextBox Width="140" Text="{Binding Input.HotPlugIntervalMs, UpdateSourceTrigger=LostFocus}"/></WrapPanel>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListBox x:Name="DevicesList" ItemsSource="{Binding Input.Devices}" DisplayMemberPath="Name" SelectionChanged="DevicesList_SelectionChanged"/>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="添加" Click="AddDevice_Click"/><Button Content="复制" Click="DuplicateDevice_Click"/><Button Content="删除" Click="DeleteDevice_Click"/></WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="上移" Click="MoveDeviceUp_Click"/><Button Content="下移" Click="MoveDeviceDown_Click"/></WrapPanel>
                            </Grid>
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                                <Grid DataContext="{Binding SelectedItem, ElementName=DevicesList}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <CheckBox Grid.Column="1" Content="启用此设备" IsChecked="{Binding Enabled}"/>
                                    <TextBlock Grid.Row="1" Text="名称" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Text="解析配置" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.HidDeviceProfiles}" SelectedItem="{Binding Profile}"/>
                                    <TextBlock Grid.Row="3" Text="玩家 (0/1/2)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Player, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="4" Text="同型号设备序号" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DeviceIndex, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Row="5" Text="VID" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding VendorId, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 0x0CA3"/>
                                    <TextBlock Grid.Row="6" Text="PID 列表" Style="{StaticResource FieldLabel}"/><StackPanel Grid.Row="6" Grid.Column="1"><TextBox AcceptsReturn="True" MinHeight="90" Text="{Binding ProductIds, Converter={StaticResource DelimitedListConverter}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="每行一个，例如 0x0021" Style="{StaticResource HintText}"/></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Update sources -->
                <TabItem>
                    <Grid Margin="28,24,34,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16"><TextBlock Text="更新源" Style="{StaticResource SectionTitle}"/><TextBlock Text="定义 HTTP 文件服务器或 U 盘更新目录，游戏通过 ID 引用。" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListBox x:Name="SourcesList" ItemsSource="{Binding UpdateSources}" DisplayMemberPath="Id" SelectionChanged="SourcesList_SelectionChanged"/>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="添加" Click="AddSource_Click"/><Button Content="复制" Click="DuplicateSource_Click"/><Button Content="删除" Click="DeleteSource_Click"/></WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="上移" Click="MoveSourceUp_Click"/><Button Content="下移" Click="MoveSourceDown_Click"/></WrapPanel>
                            </Grid>
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                                <Grid DataContext="{Binding SelectedItem, ElementName=SourcesList}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <CheckBox Grid.Column="1" Content="启用此更新源" IsChecked="{Binding Enabled}"/>
                                    <TextBlock Grid.Row="1" Text="唯一 ID" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Text="类型" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.UpdateSourceKinds}" SelectedItem="{Binding Kind}"/>
                                    <TextBlock Grid.Row="3" Text="HTTP 根地址" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 http://192.168.1.10:8000/"/>
                                    <TextBlock Grid.Row="4" Text="用户名" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="5" Text="密码" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" ToolTip="启动器配置以明文保存此值"/>
                                    <TextBlock Grid.Row="6" Text="U 盘盘符" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DriveLetter, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 F:"/>
                                    <TextBlock Grid.Row="7" Text="更新目录" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Row="8" Grid.Column="1" Content="目录中包含多个游戏" IsChecked="{Binding ContainsMultipleGames}"/>
                                    <TextBlock Grid.Row="9" Text="请求超时 (ms)" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RequestTimeoutMs, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Operations -->
                <TabItem>
                    <Grid Margin="28,24,34,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16"><TextBlock Text="机台操作" Style="{StaticResource SectionTitle}"/><TextBlock Text="管理菜单中的更新、关机、重启、退出和自定义命令。" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListBox x:Name="OperationsList" ItemsSource="{Binding Operations}" DisplayMemberPath="Title" SelectionChanged="OperationsList_SelectionChanged"/>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="添加" Click="AddOperation_Click"/><Button Content="复制" Click="DuplicateOperation_Click"/><Button Content="删除" Click="DeleteOperation_Click"/></WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="上移" Click="MoveOperationUp_Click"/><Button Content="下移" Click="MoveOperationDown_Click"/></WrapPanel>
                            </Grid>
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" DataContext="{Binding SelectedItem, ElementName=OperationsList}">
                                    <GroupBox Header="菜单项">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Text="唯一 ID" Style="{StaticResource FieldLabel}"/><TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Text="标题" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="2" Text="说明" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="3" Text="操作类型" Style="{StaticResource FieldLabel}"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static ui:EnumOptions.OperationKinds}" SelectedItem="{Binding Kind}"/>
                                            <CheckBox Grid.Row="4" Grid.Column="1" Content="执行后关闭启动器" IsChecked="{Binding CloseAfterRun}"/>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="命令（Kind 为 Command 时使用）">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <CheckBox Grid.Column="1" Content="启用命令" IsChecked="{Binding Command.Enabled}"/>
                                            <TextBlock Grid.Row="1" Text="文件" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Command.File, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="2" Text="候选文件" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" AcceptsReturn="True" MinHeight="58" Text="{Binding Command.Candidates, Converter={StaticResource DelimitedListConverter}, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Row="3" Text="参数" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Command.Arguments, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="4" Text="工作目录" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Command.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Grid.Row="5" Grid.Column="1" Content="等待命令退出" IsChecked="{Binding Command.WaitForExit}"/>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="执行确认">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <CheckBox Grid.Column="1" Content="执行前要求确认" IsChecked="{Binding Confirmation.Enabled}"/>
                                            <TextBlock Grid.Row="1" Text="确认标题" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Confirmation.Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空时使用本地化默认文案"/>
                                            <TextBlock Grid.Row="2" Text="确认消息" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Confirmation.Message, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空时使用本地化默认文案"/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel></ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Validation -->
                <TabItem>
                    <Grid Margin="28,24,34,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="校验与 JSON" Style="{StaticResource SectionTitle}"/><TextBlock Text="保存前检查引用和范围；预览内容就是最终写入的 JSON。" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button DockPanel.Dock="Right" Content="刷新检查与预览" Click="RefreshPreview_Click" HorizontalAlignment="Right"/></DockPanel>
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="ValidationSummary" Text="尚未检查" Margin="14,11" FontWeight="SemiBold"/>
                                <DataGrid x:Name="ValidationGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns><DataGridTextColumn Header="级别" Binding="{Binding Icon}" Width="75"/><DataGridTextColumn Header="位置" Binding="{Binding Section}" Width="210"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="#101521" BorderBrush="#293149" BorderThickness="1" Padding="12">
                            <TextBox x:Name="JsonPreview" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#DAE2F2" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,7"><TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PathText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
