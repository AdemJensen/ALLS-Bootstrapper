<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Alls.Configurator</RootNamespace>
    <AssemblyName>ALLS.Configurator</AssemblyName>
    <ApplicationIcon>..\Alls.Bootstrapper\Assets\ALLS.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Alls.Bootstrapper\Models\LauncherSettings.cs" Link="Shared\LauncherSettings.cs" />
    <Compile Include="..\Alls.Bootstrapper\Models\BootPhase.cs" Link="Shared\BootPhase.cs" />
  </ItemGroup>
</Project>
