<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Alls.Configurator</RootNamespace>
    <AssemblyName>ALLS.Configurator</AssemblyName>
    <ApplicationIcon>..\Alls.Bootstrapper\Assets\ALLS.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Alls.Bootstrapper\Models\LauncherSettings.cs" Link="Shared\LauncherSettings.cs" />
    <Compile Include="..\Alls.Bootstrapper\Models\BootPhase.cs" Link="Shared\BootPhase.cs" />
    <EmbeddedResource Include="..\Alls.Bootstrapper\Resources\Strings.zh-CN.xaml"
                      LogicalName="Alls.Configurator.Resources.Strings.zh-CN.xaml"
                      WithCulture="false" />
    <EmbeddedResource Include="..\Alls.Bootstrapper\Resources\Strings.en-US.xaml"
                      LogicalName="Alls.Configurator.Resources.Strings.en-US.xaml"
                      WithCulture="false" />
    <EmbeddedResource Include="..\Alls.Bootstrapper\Resources\Strings.ja-JP.xaml"
                      LogicalName="Alls.Configurator.Resources.Strings.ja-JP.xaml"
                      WithCulture="false" />
  </ItemGroup>
</Project>
